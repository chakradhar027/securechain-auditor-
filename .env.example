# Backend Application Configuration
APP_NAME="SecureChain Auditor"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./backend/storage/securechain.db
# For PostgreSQL in production/docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securechain_db

# Security & Secret Keys
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Scanner Binaries & Flags
SLITHER_PATH=slither
MYTHRIL_PATH=myth
FOUNDRY_FORGE_PATH=forge

# Blockchain Explorers (Optional API keys for on-chain contract fetching)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Storage Paths (Canonical Backend Storage)
STORAGE_DIR=./backend/storage
UPLOADS_DIR=./backend/storage/uploads
REPORTS_DIR=./backend/storage/reports
TEMP_DIR=./backend/storage/temp

